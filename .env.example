# ======================================================================
# Google Drive MCP — настройки. Скопируйте в .env и заполните.
# ======================================================================

# ----- Доступ к коннектору (ОБЯЗАТЕЛЬНО для HTTP) -----
# Без токена сервер по HTTP не запустится. Сгенерировать: openssl rand -hex 32
MCP_AUTH_TOKEN=

# ----- Google: вход через браузер (рекомендуется) -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://ВАШ-ДОМЕН/oauth/callback
# После запуска откройте https://ВАШ-ДОМЕН/oauth/start?token=<MCP_AUTH_TOKEN> и войдите в Google.

# Альтернативы: refresh-токен вручную (python get_token.py) или сервисный аккаунт
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_SERVICE_ACCOUNT_FILE=/opt/gdrive-mcp/service-account.json
# GOOGLE_IMPERSONATE_USER=user@company.ru

# ----- Безопасность (значения ниже — безопасные по умолчанию) -----
# Только чтение: никаких изменений на диске
GDRIVE_READ_ONLY=false
# Подтверждение пользователя для опасных действий (удаление, перезапись, доступы). Не отключайте.
GDRIVE_REQUIRE_CONFIRM=true
# Удаление в корзину (обратимо 30 дней)
GDRIVE_ALLOW_DELETE=true
# Удаление папок целиком (вместе с содержимым)
GDRIVE_ALLOW_FOLDER_DELETE=false
# Безвозвратное удаление (и то только из корзины)
GDRIVE_ALLOW_PERMANENT_DELETE=false
# Полная замена содержимого обычных файлов (docx/xlsx/pdf). Google Docs/Sheets целиком не перезаписываются никогда.
GDRIVE_ALLOW_OVERWRITE=true
# Выдача доступа людям по email / отзыв доступа
GDRIVE_ALLOW_SHARING=true
GDRIVE_ALLOW_REVOKE=true
# Доступ «всем по ссылке» — риск утечки
GDRIVE_ALLOW_PUBLIC_SHARING=false

# Жёстко ограничить коннектор папками (ID через запятую; доступно всё внутри них на любой глубине).
# Пусто — весь диск подключённого аккаунта.
GDRIVE_ALLOWED_FOLDER_IDS=
# Папка по умолчанию для списка и создания файлов (не ограничение)
GDRIVE_ROOT_FOLDER_ID=

# Журнал всех изменений (с копиями затёртых данных таблиц)
# GDRIVE_AUDIT_LOG=/opt/gdrive-mcp/logs/audit.log

# ----- Сервер -----
# stdio — Claude Desktop; streamable-http — хостинг; sse — старые клиенты
MCP_TRANSPORT=streamable-http
MCP_HOST=127.0.0.1
MCP_PORT=8000
# Домен(ы) через запятую — защита от DNS rebinding
# MCP_ALLOWED_HOSTS=gdrive.example.ru
APP_CONTACT_EMAIL=

# ----- Лимиты и надёжность -----
GDRIVE_MAX_DOWNLOAD_MB=20
GDRIVE_MAX_READ_MB=50
GDRIVE_MAX_UPLOAD_MB=50
GDRIVE_MAX_TEXT_CHARS=200000
GDRIVE_MAX_SHEET_CELLS=20000
GDRIVE_HTTP_TIMEOUT=60
GDRIVE_RETRIES=4
