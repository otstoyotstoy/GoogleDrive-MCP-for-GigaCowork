# ===== Авторизация Google (выберите ОДИН вариант) =====

# Вариант 1 — OAuth пользователя (обычный «Мой диск»). Токен получить: python get_token.py
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Вариант 2 — сервисный аккаунт (для общих дисков / Shared Drives или Google Workspace)
# GOOGLE_SERVICE_ACCOUNT_FILE=/opt/gdrive-mcp/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# GOOGLE_IMPERSONATE_USER=user@company.ru   # только Workspace с domain-wide delegation

# Ограничить коннектор одной папкой (ID из ссылки drive.google.com/drive/folders/<ID>)
# GDRIVE_ROOT_FOLDER_ID=

# ===== Сервер =====
# stdio — для Claude Desktop; streamable-http — для хостинга и подключения по URL; sse — для старых клиентов
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Секретный токен доступа к коннектору (сгенерировать: openssl rand -hex 32)
MCP_AUTH_TOKEN=
# Домен(ы), с которых приходит трафик через nginx, через запятую (включает защиту от DNS rebinding)
# MCP_ALLOWED_HOSTS=gdrive.example.ru

# ===== Лимиты =====
GDRIVE_MAX_DOWNLOAD_MB=20
GDRIVE_MAX_UPLOAD_MB=50
GDRIVE_MAX_TEXT_CHARS=200000
